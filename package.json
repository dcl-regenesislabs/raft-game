{
  "name": "raft-game",
  "version": "1.0.0",
  "description": "Raft Game — survive on a raft in Decentraland: fish, scavenge, craft, and build.",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "npm run prepare:scene && node scripts/force-production.mjs && sdk-commands deploy --target-content https://worlds-content-server.decentraland.org --multi-scene",
    "build": "sdk-commands build",
    "check:textures": "python3 scripts/check_gltf_textures.py",
    "fix:textures": "python3 scripts/check_gltf_textures.py --fix",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "server-logs": "sdk-commands sdk-server-logs",
    "prepare:scene": "node scripts/build-scene-json.mjs",
    "upgrade-sdk:auth-server": "npm install --save-dev --save-exact @dcl/sdk@auth-server @dcl/js-runtime@auth-server && npm install --save-exact @dcl/ecs@auth-server"
  },
  "devDependencies": {
    "@dcl/asset-packs": "latest",
    "@dcl/js-runtime": "7.29.1-35154657340.commit-e2bbcc9",
    "@dcl/sdk": "7.29.1-35154657340.commit-e2bbcc9"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "dependencies": {
    "@dcl/ecs": "7.29.1-35154657340.commit-e2bbcc9"
  },
  "overrides": {
    "@dcl/ecs": "$@dcl/ecs"
  }
}