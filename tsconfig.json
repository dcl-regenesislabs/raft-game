{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@dcl/asset-packs/*": ["node_modules/@dcl/inspector/node_modules/@dcl/asset-packs/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "assets/**/*.ts",
    "assets/**/*.tsx"
  ],
  // src/server relies on the '@dcl/sdk/server' subpath, which the current
  // controls-customization SDK snapshot does not ship. The server code is
  // dormant (not in the bundle graph) but tsc checks everything under
  // `include`, so keep it out until the server APIs return.
  "exclude": ["src/server"],
  "extends": "@dcl/sdk/types/tsconfig.ecs7.json"
}
